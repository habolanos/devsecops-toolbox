{
  "_info": "Template de configuración unificada para DevSecOps Toolbox. Copia como config.json y completa los valores. NUNCA subas config.json al repositorio.",
  "_version": "1.7.0",

  "auth": {
    "_info": "Configuración de autenticación automática por plataforma",
    "login": {
      "gcp": {
        "enabled": true,
        "_info": "Si es true, valida autenticación GCP y ejecuta 'gcloud auth login' si es necesario",
        "auto_login": true,
        "timeout_seconds": 30
      },
      "azure": {
        "enabled": false,
        "_info": "Si es true, valida autenticación Azure y ejecuta 'az login' si es necesario",
        "auto_login": true,
        "timeout_seconds": 30
      },
      "azdo": {
        "enabled": true,
        "_info": "Si es true, valida que PAT esté configurado",
        "auto_login": false,
        "timeout_seconds": 10
      },
      "aws": {
        "enabled": false,
        "_info": "Si es true, valida autenticación AWS y ejecuta 'aws configure' si es necesario",
        "auto_login": true,
        "timeout_seconds": 30
      }
    }
  },

  "azdo": {
    "_info": "Configuración de Azure DevOps",
    "enabled": true,
    "organization_url": "https://dev.azure.com/<TU_ORGANIZACION>",
    "organization": "<TU_ORGANIZACION>",
    "project": "<TU_PROYECTO>",
    "pat": "<TU_PAT_TOKEN>",
    
    "pat_permissions": {
      "_info": "Permisos mínimos requeridos en el PAT para cada herramienta",
      "pr_master_checker": ["Code (Read)", "Release (Read)"],
      "branch_policy_checker": ["Code (Read)", "Project and Team (Read)"],
      "release_cd_health": ["Release (Read)"],
      "pipeline_drift": ["Release (Read)"],
      "pipeline_updater": ["Release (Read & Write)"],
      "pipeline_rollback": ["Release (Read & Write)"]
    },
    
    "defaults": {
      "timezone": "America/Mazatlan",
      "threads": 8,
      "output_format": "csv",
      "pipelines_clone_dir": "~/.devsecops-toolbox/cache",
      "debug": false
    },
    
    "tools": {
      "pr_master_checker": {
        "_info": "Lista PRs hacia master con pipeline CD y stage validador",
        "target_branch": "master",
        "pr_status": "active",
        "stage_name": "validador",
        "top_prs": 500,
        "threads": 6
      },
      "branch_policy_checker": {
        "_info": "Audita políticas de rama para master/main, QA y develop",
        "branches": {
          "master": ["master", "main"],
          "qa": ["qa", "QA", "release"],
          "develop": ["develop", "dev"]
        }
      },
      "release_cd_health": {
        "_info": "Score de salud de Release Pipelines CD",
        "top_releases": 15,
        "sort": "score",
        "diagram": false
      },
      "pipeline_drift": {
        "_info": "Drift entre pipeline actual y snapshot del último release",
        "min_severity": null,
        "sort": "severity"
      },
      "properties_branch_diff": {
        "_info": "Compara config de un componente entre dos ramas",
        "repo": "<nombre-del-repo-de-properties>",
        "source_branch": "develop",
        "target_branch": "master",
        "context_lines": 3,
        "output_format": "excel"
      },
      "repo_branch_diff": {
        "_info": "Informe ejecutivo de impacto de cambios entre ramas",
        "repo": "",
        "source_branch": "develop",
        "target_branch": "master",
        "top_files": 60,
        "top_commits": 25,
        "output_format": "excel"
      },
      "pipeline_updater": {
        "_info": "Actualización masiva de Release Pipelines",
        "definition_id": 9999999,
        "branch_config": "config-cadenaSuministro",
        "task_name": "get file k8-manifest",
        "old_pattern": "$(path_pipelineConfig)",
        "new_pattern": "$(path_pipelineConfigYml)"
      }
    }
  },

  "gcp": {
    "_info": "Configuración de Google Cloud Platform",
    "enabled": true,
    "project_id": "<TU_PROJECT_ID>",
    "region": "us-central1",
    "credentials": {
      "_info": "Opciones: 'adc' (Application Default Credentials), 'service_account', 'oauth'",
      "type": "adc",
      "service_account_key_path": "",
      "impersonate_service_account": ""
    },
    "kubernetes": {
      "cluster_name": "",
      "cluster_region": "us-central1"
    },
    "defaults": {
      "timezone": "America/Mazatlan",
      "output_format": "json"
    },

    "service_accounts_reporter": {
      "_info": "Configuración para el reporte multi-proyecto de service accounts (Tool 38)",
      "enabled": true,
      "_enabled_info": "Cambiar a true para habilitar el reporte de service accounts",
      
      "projects": [
        "<PROYECTO_GCP_1>",
        "<PROYECTO_GCP_2>",
        "<PROYECTO_GCP_3>"
      ],
      "_projects_info": "Array de nombres de proyectos GCP a analizar. Ej: ['proyecto-prod', 'proyecto-staging']",
      
      "defaults": {
        "mode": "all",
        "_mode_info": "Opciones: all, security, compliance, usage",
        "output_format": "json",
        "_output_format_info": "Opciones: json, csv, excel, html",
        "include_activity": true,
        "activity_days": 30,
        "key_rotation_policy_days": 90,
        "parallel_workers": 5,
        "_parallel_workers_info": "Número de workers para paralelización (default: 5)",
        "timeout_seconds": 300,
        "cache_enabled": true,
        "cache_ttl_minutes": 60
      },
      
      "security": {
        "_info": "Configuración de análisis de seguridad",
        "dangerous_roles": [
          "roles/editor",
          "roles/owner",
          "roles/compute.admin",
          "roles/iam.securityAdmin",
          "roles/resourcemanager.organizationAdmin"
        ],
        "_dangerous_roles_info": "Roles considerados peligrosos. Personalizar según políticas de seguridad",
        "alert_on_risk_level": [
          "HIGH",
          "CRITICAL"
        ],
        "_alert_on_risk_level_info": "Niveles de riesgo que generan alertas",
        "encrypt_reports": false,
        "_encrypt_reports_info": "Encriptar reportes (requiere configuración adicional)"
      },
      
      "compliance": {
        "_info": "Configuración de cumplimiento normativo",
        "policies": [
          {
            "name": "key_rotation_90days",
            "description": "Rotación de claves cada 90 días",
            "enabled": true,
            "threshold_days": 90
          },
          {
            "name": "no_user_managed_keys",
            "description": "No permitir claves user-managed",
            "enabled": false,
            "_enabled_info": "Cambiar a true para habilitar esta política"
          },
          {
            "name": "no_excessive_permissions",
            "description": "No permitir roles peligrosos",
            "enabled": true
          }
        ]
      },
      
      "notifications": {
        "_info": "Configuración de notificaciones automáticas",
        "enabled": false,
        "_enabled_info": "Cambiar a true para habilitar notificaciones",
        "on_high_risk": true,
        "on_compliance_violation": true,
        "webhook_url": "<TU_TEAMS_WEBHOOK_URL>",
        "_webhook_url_info": "Obtener en Teams: Equipo → Connectors → Incoming Webhook"
      }
    }
  },

  "azure": {
    "_info": "Configuración de Azure Cloud Platform",
    "enabled": false,
    "subscription_id": "<TU_SUBSCRIPTION_ID>",
    "tenant_id": "<TU_TENANT_ID>",
    "region": "eastus",
    "credentials": {
      "_info": "Opciones: 'cli' (Azure CLI), 'service_principal', 'managed_identity'",
      "type": "cli",
      "client_id": "",
      "client_secret": "",
      "certificate_path": ""
    },
    "kubernetes": {
      "cluster_name": "",
      "cluster_region": "eastus",
      "resource_group": ""
    },
    "defaults": {
      "timezone": "America/Mazatlan",
      "output_format": "json"
    }
  },

  "aws": {
    "_info": "Configuración de Amazon Web Services",
    "enabled": true,
    "profile": "default",
    "region": "us-east-1",
    "account_id": "",
    "credentials": {
      "_info": "Opciones: 'profile' (usa AWS CLI profile), 'keys' (access/secret keys), 'role' (assume role)",
      "type": "profile",
      "access_key_id": "",
      "secret_access_key": "",
      "session_token": "",
      "role_arn": ""
    },
    "defaults": {
      "output_format": "json",
      "output_dir": "outcome"
    }
  },

  "terminal": {
    "_info": "Configuración de Terminal Scripts - Scripts shell agnósticos",
    "enabled": true,
    "_enabled_info": "Terminal scripts no requieren configuración especial. Se ejecutan localmente.",
    "defaults": {
      "timezone": "America/Mazatlan",
      "output_format": "json",
      "debug": false
    }
  },

  "kpi_analyzer": {
    "_info": "Configuración de KPI Analyzer - Análisis de KPIs DevSecOps",
    "enabled": true,
    "_enabled_info": "KPI Analyzer no requiere configuración especial. Usa datos de las otras plataformas.",
    "defaults": {
      "timezone": "America/Mazatlan",
      "output_format": "json",
      "maturity_model": "6_levels",
      "_maturity_model_info": "Modelo de madurez: 6_levels (Inicial, Repetible, Definido, Gestionado, Optimizado, Excelencia)",
      "debug": false
    },
    "benchmarks": {
      "_info": "Benchmarks de industria para comparación",
      "enabled": true,
      "industry": "tech",
      "_industry_info": "Industria: tech, finance, healthcare, retail"
    }
  },

  "dashboard": {
    "_info": "Configuración del Dashboard Matutino DevSecOps (INTEGRADO EN KPI ANALYZER PRO v1.9.6). Usa credenciales de AZDO (org, project, pat)",
    "enabled": true,
    "_credentials_info": "Se usan automáticamente desde la sección 'azdo' (organization, project, pat). Solo agregar webhook_url si se desean notificaciones a Teams. Dashboard está integrado en KPI Analyzer Pro (Opción 5).",
    "webhook_url": "<TU_TEAMS_WEBHOOK_URL>",
    
    "schedule": {
      "_info": "Configuración de ejecución automática",
      "enabled": true,
      "cron": "0 7 * * *",
      "_cron_info": "Expresión cron: 0 7 * * * = 7:00 AM diariamente",
      "timezone": "America/Mazatlan"
    },
    
    "metrics": {
      "_info": "Métricas a incluir en el dashboard",
      "health_score": {
        "enabled": true,
        "_info": "DORA Metrics: Deployment Frequency, Lead Time, MTTR, Change Failure Rate, System Uptime",
        "weights": {
          "_info": "Pesos para cálculo de Health Score (suma debe ser 1.0)",
          "deployment_frequency": 0.20,
          "lead_time": 0.20,
          "mttr": 0.25,
          "change_failure_rate": 0.20,
          "system_uptime": 0.15
        }
      },
      "code_coverage": {
        "enabled": true,
        "_info": "ISO 29119: Overall Coverage, Line, Branch, Function, Test Execution Rate",
        "thresholds": {
          "_info": "Umbrales de clasificación para cobertura de código",
          "critical": 60,
          "acceptable": 75,
          "good": 85,
          "excellent": 95
        }
      },
      "pr_metrics": {
        "enabled": true,
        "_info": "Pull Request Effectiveness: Review Time, Approval Rate, Coverage, Rejection Rate"
      },
      "branch_compliance": {
        "enabled": true,
        "_info": "Branch Protection: Protected Branches, Compliance Percentage"
      },
      "pipeline_status": {
        "enabled": true,
        "_info": "Pipeline Health: Success Rate, Failed Pipelines, Average Duration"
      }
    },
    
    "alerts": {
      "_info": "Umbrales de alertas críticas y advertencias",
      "critical": {
        "health_score": 40,
        "code_coverage": 60,
        "deployment_failure_rate": 15,
        "mttr_hours": 4,
        "system_uptime": 99,
        "review_time_minutes": 120,
        "approval_rate": 70
      },
      "warning": {
        "health_score": 60,
        "code_coverage": 75,
        "system_uptime": 99.5,
        "review_time_minutes": 60,
        "approval_rate": 80
      }
    },
    
    "notifications": {
      "_info": "Configuración de notificaciones",
      "teams": {
        "enabled": true,
        "webhook_url": "<TU_TEAMS_WEBHOOK_URL>",
        "_webhook_info": "Obtener en Teams: Equipo → Connectors → Incoming Webhook",
        "group_name": "Equipo Comercial/CDS",
        "mention_on_critical": true,
        "retry_attempts": 3,
        "timeout_seconds": 30
      },
      "email": {
        "enabled": false,
        "recipients": []
      },
      "slack": {
        "enabled": false,
        "webhook_url": ""
      }
    },
    
    "output": {
      "_info": "Configuración de salida",
      "directory": "outcome/dashboard",
      "history_directory": "outcome/dashboard/history",
      "retention_days": 90,
      "formats": ["json", "html"]
    },
    
    "tools": {
      "_info": "Configuración de herramientas del dashboard",
      "consolidator": {
        "enabled": true,
        "tool_id": 26,
        "name": "Dashboard Consolidator",
        "timeout_seconds": 300,
        "parallel_execution": true,
        "max_workers": 8
      },
      "generator": {
        "enabled": true,
        "tool_id": 27,
        "name": "Dashboard Generator",
        "timeout_seconds": 60,
        "output_format": "html"
      },
      "scheduler": {
        "enabled": true,
        "tool_id": 29,
        "name": "Dashboard Scheduler",
        "run_consolidator": true,
        "run_generator": true,
        "send_notifications": true
      }
    }
  },

  "global": {
    "_info": "Configuración global aplicable a todas las plataformas",
    "debug": false,
    "log_commands": true,
    "verbose": false,
    "output_dir": "outcome",
    "_output_dir_info": "Ruta relativa a la raíz de scm/ (ej: 'outcome' → scm/outcome). Si es ruta absoluta se usa tal cual. Inyectada como DEVSECOPS_OUTPUT_DIR a todas las herramientas.",
    "log_level": "INFO",
    "proxy": {
      "enabled": false,
      "http": "",
      "https": "",
      "no_proxy": ["localhost", "127.0.0.1"]
    }
  }
}
