# ═══════════════════════════════════════════════════════════════════════════════
# DevSecOps Toolbox - Docker Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env y edita con tus credenciales:
#   cp docker/.env.example docker/.env
# ═══════════════════════════════════════════════════════════════════════════════

# Azure (opcional - se configuran en tiempo de ejecución)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# AWS (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=

# GCP (opcional)
GCP_SERVICE_ACCOUNT_KEY=
GCP_PROJECT_ID=

# Kubernetes (opcional)
KUBECONFIG_CONTENT=
